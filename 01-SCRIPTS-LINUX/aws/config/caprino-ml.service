[Unit]
Description=Proyecto Caprino - Servicio ML
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/caprino/ml-service
Environment="PATH=/var/www/caprino/ml-service/venv/bin"
ExecStart=/var/www/caprino/ml-service/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
